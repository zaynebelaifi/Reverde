        <mxCell id="sc-a12" value="&lt;b&gt;0&lt;/b&gt; · At start-up the services register with Eureka. Discovery clients keep a cached copy of the registry." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=11;spacingTop=0;" vertex="1" parent="1">
