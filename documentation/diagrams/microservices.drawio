        <mxCell id="sc-a15" value="&lt;b&gt;3&lt;/b&gt; · where is RECOVERY-SERVICE?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
