          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a30" value="&lt;b&gt;Error cases&lt;/b&gt;&lt;br&gt;• 401 / 403 if authentication or permissions fail.&lt;br&gt;• 400 if a required field is invalid.&lt;br&gt;• 404 if the selected incident does not exist.&lt;br&gt;• 503 if a required dependency is unavailable." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
