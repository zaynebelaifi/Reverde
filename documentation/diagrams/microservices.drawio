 y="0" as="offset" /></mxGeometry></mxCell><mxCell id="ac-a48" value="Recovery planning reference&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Available when a coordinator creates a project&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;spacingLeft=44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="420" width="230" height="60" as="geometry" /></mxCell><mxCell id="ac-a49" value="" style="shape=note;size=6;fillColor=#fff2cc;strokeColor=#a0855b;" vertex="1" parent="ac-a48"><mxGeometry x="8" y="14" width="32" height="32" as="geometry" /></mxCell><mxCell id="ac-a50" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ac-a30" target="ac-a48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ac-a51" value="→ identifies the zone for post-fire observations" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1150" y="222" width="250" height="30" as="geometry" /></mxCell><mxCell id="ac-a52" value="{&lt;br&gt;&amp;nbsp; &quot;eventId&quot;: &quot;7b1e…&quot;,&lt;br&gt;&amp;nbsp; &quot;type&quot;: &quot;IncidentVerified&quot;,&lt;br&gt;&amp;nbsp; &quot;occurredAt&quot;: &quot;2026-11-09T09:15Z&quot;,&lt;br&gt;&amp;nbsp; &quot;incidentId&quot;: 6,&lt;br&gt;&amp;nbsp; &quot;forestZoneId&quot;: 4&lt;br&gt;}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="230" height="190" as="geometry" /></mxCell><mxCell id="ac-a53" value="&lt;b&gt;Message (JSON)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="230" height="24" as="geometry" /></mxCell><mxCell id="ac-a54" value="&lt;b&gt;Design rules&lt;/b&gt;&lt;br&gt;• Publish after saving the verified status.&lt;br&gt;• The producer declares the exchange. Each consumer owns its queue.&lt;br&gt;• Consumers acknowledge after processing and deduplicate by &lt;b&gt;eventId&lt;/b&gt;.&lt;br&gt;• Rejected recovery messages go to &lt;i&gt;reverde.events.dlx&lt;/i&gt; and the recovery DLQ.&lt;br&gt;• Messages can wait in the queue while a consumer is down." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="640" height="170" as="geometry" /></mxCell><mxCell id="ac-a55" value="&lt;b&gt;ReVerde event flow&lt;/b&gt;&lt;br&gt;• The incident service publishes &lt;b&gt;IncidentVerified&lt;/b&gt;.&lt;br&gt;• The recovery service records the incident reference for planning.&lt;br&gt;• An optional biodiversity consumer can flag the zone for follow-up observations.&lt;br&gt;&lt;br&gt;&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;• Exchange names, routing keys and consumers are proposed for integration." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="740" width="700" height="170" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="keycloak" id="6-keycloak"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="kc-a1" value="&lt;b style='font-size:16px'&gt;Keycloak — securing ReVerde with an API Gateway (OAuth2 / OpenID Connect + JWT)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;Example deployment: React obtains a JWT from Keycloak. The gateway validates the token before routing.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1240" height="46" as="geometry" /></mxCell><mxCell id="kc-a2" value="&lt;b&gt;User + ReVerde app&lt;/b&gt;&lt;br&gt;(React web client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;verticalAlign=bottom;spacingBottom=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="200" height="110" as="geometry" /></mxCell><mxCell id="kc-a3" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PGNpcmNsZSBjeD0iMTIiIGN5PSI4IiByPSI0LjUiIGZpbGw9IiM3RTBDNkUiLz48cGF0aCBkPSJNMyAyMmMwLTUgNC04LjUgOS04LjVzOSAzLjUgOSA4LjV6IiBmaWxsPSIjN0UwQzZFIi8+PC9zdmc+;" vertex="1" parent="kc-a2"><mxGeometry x="78" y="12" width="44" height="44" as="geometry" /></mxCell><mxCell id="kc-a4" value="&lt;b&gt;Keycloak&lt;/b&gt; · :8180&lt;br&gt;example identity provider&lt;br&gt;realm &lt;b&gt;reverde&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAD7AC;strokeColor=#B46504;align=left;spacingLeft=54;fontSize=11;arcSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="250" height="100" as="geometry" /></mxCell><mxCell id="kc-a5" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="kc-a4"><mxGeometry x="8" y="32" width="34" height="34" as="geometry" /></mxCell><mxCell id="kc-a6" value="&lt;b&gt;API Gateway&lt;/b&gt; · :8080&lt;br&gt;Spring Cloud Gateway&lt;br&gt;OAuth2 Resource Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1BA1E2;strokeColor=#006EAF;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="220" height="110" as="geometry" /></mxCell><mxCell id="kc-a7" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="kc-a6"><mxGeometry x="8" y="38" width="34" height="34" as="geometry" /></mxCell><mxCell id="kc-a8" value="&lt;b&gt;MS3 · incident-service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;(same pattern for other ReVerde services)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;spacingLeft=40;fontSize=11;arcSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="330" width="240" height="110" as="geometry" /></mxCell><mxCell id="kc-a9" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="kc-a8"><mxGeometry x="8" y="42" width="26" height="26" as="geometry" /></mxCell><mxCell id="kc-a10" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;exitX=0.3;exitY=0;entryX=0;entryY=0.3;" edge="1" parent="1" source="kc-a2" target="kc-a4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="110" /></Array></mxGeometry></mxCell><mxCell id="kc-a11" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;1&lt;/span&gt; login on the Keycloak page&lt;br&gt;(Authorization Code + PKCE)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a10"><mxGeometry x="0.3" relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset" /></mxGeometry></mxCell><mxCell id="kc-a12" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;fontColor=#2D7600;exitX=0;exitY=0.75;entryX=0.75;entryY=0;" edge="1" parent="1" source="kc-a4" target="kc-a2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="155" /></Array></mxGeometry></mxCell><mxCell id="kc-a13" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;2&lt;/span&gt; access token (JWT) + refresh token" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a12"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint x="0" y="14" as="offset" /></mxGeometry></mxCell><mxCell id="kc-a14" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="kc-a2" target="kc-a6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kc-a15" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;3&lt;/span&gt; request + header&lt;br&gt;Authorization: Bearer &amp;lt;JWT&amp;gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a14"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset" /></mxGeometry></mxCell><mxCell id="kc-a16" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;fontColor=#2D7600;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="kc-a6" target="kc-a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kc-a17" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;8&lt;/span&gt; response&lt;br&gt;(401 no / bad token · 403 wrong role)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a16"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="22" as="offset" /></mxGeometry></mxCell><mxCell id="kc-a18" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B46504;fontColor=#B46504;exitX=0.4;exitY=0;entryX=0.192;entryY=1;" edge="1" parent="1" source="kc-a6" target="kc-a4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kc-a19" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;4&lt;/span&gt; public keys (JWKS)&lt;br&gt;downloaded once, cached" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a18"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="90" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="kc-a20" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="kc-a6" target="kc-a8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kc-a21" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;6&lt;/span&gt; route lb://INCIDENT-SERVICE&lt;br&gt;(token forwarded)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a20"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset" /></mxGeometry></mxCell><mxCell id="kc-a22" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;fontColor=#2D7600;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="kc-a8" target="kc-a6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kc-a23" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;7&lt;/span&gt; response" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a22"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="14" as="offset" /></mxGeometry></mxCell><mxCell id="kc-a24" value="&lt;span style='background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;'&gt;5&lt;/span&gt; the gateway checks the &lt;b&gt;signature&lt;/b&gt;, the expiry (&lt;i&gt;exp&lt;/i&gt;), the issuer (&lt;i&gt;iss&lt;/i&gt;) and the &lt;b&gt;role&lt;/b&gt; — no call to Keycloak per request." style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="452" width="270" height="70" as="geometry" /></mxCell><mxCell id="kc-a25" value="&lt;b&gt;Access token (JWT) — decoded payload&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="330" height="22" as="geometry" /></mxCell><mxCell id="kc-a26" value="{&lt;br&gt;&amp;nbsp; &quot;iss&quot;: &quot;http://localhost:8180/realms/reverde&quot;,&lt;br&gt;&amp;nbsp; &quot;sub&quot;: &quot;4f1c…&quot;,&lt;br&gt;&amp;nbsp; &quot;preferred_username&quot;: &quot;demo-user&quot;,&lt;br&gt;&amp;nbsp; &quot;realm_access&quot;: { &quot;roles&quot;: [&quot;REPORTER&quot;] },&lt;br&gt;&amp;nbsp; &quot;exp&quot;: 1794236400&lt;br&gt;}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="330" height="190" as="geometry" /></mxCell><mxCell id="kc-a27" value="&lt;b&gt;Keycloak configuration&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="560" width="380" height="22" as="geometry" /></mxCell><mxCell id="kc-a28" value="&lt;b&gt;Example realm settings&lt;/b&gt;&lt;br&gt;• Realm &lt;b&gt;reverde&lt;/b&gt;.&lt;br&gt;• Public client &lt;b&gt;reverde-front&lt;/b&gt; with Authorization Code + PKCE.&lt;br&gt;• Example roles &lt;b&gt;REPORTER&lt;/b&gt; and &lt;b&gt;COORDINATOR&lt;/b&gt;.&lt;br&gt;• Docker example exposes Keycloak on &lt;b&gt;8180&lt;/b&gt;.&lt;br&gt;• The team still needs to confirm the identity provider and roles." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="586" width="380" height="190" as="geometry" /></mxCell><mxCell id="kc-a29" value="&lt;b&gt;Gateway side (example)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="560" width="450" height="22" as="geometry" /></mxCell><mxCell id="kc-a30" value="# application.yml&lt;br&gt;spring.security.oauth2.resourceserver.jwt.issuer-uri:&lt;br&gt;&amp;nbsp;&amp;nbsp;http://localhost:8180/realms/reverde&lt;br&gt;&lt;br&gt;// Example SecurityWebFilterChain rules&lt;br&gt;.pathMatchers(POST, &quot;/api/incidents&quot;).hasRole(&quot;REPORTER&quot;)&lt;br&gt;.anyExchange().authenticated()&lt;br&gt;&lt;br&gt;// Map realm_access.roles to ROLE_* authorities." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="586" width="450" height="190" as="geometry" /></mxCell><mxCell id="kc-a31" value="The gateway exposes the business API. The ReVerde services stay on the private Docker network." style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1240" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Forest &amp; biodiversity — synchronous" id="forest-biodiversity-synchronous">
