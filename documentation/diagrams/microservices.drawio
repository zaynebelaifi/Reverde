        <mxCell id="ac-a52" value="{&lt;br&gt;&amp;nbsp; &quot;eventId&quot;: &quot;example-id&quot;,&lt;br&gt;&amp;nbsp; &quot;type&quot;: &quot;RecoveryProjectCreated&quot;,&lt;br&gt;&amp;nbsp; &quot;occurredAt&quot;: &quot;2026-11-10T09:00:00Z&quot;,&lt;br&gt;&amp;nbsp; &quot;recoveryProjectId&quot;: 45,&lt;br&gt;&amp;nbsp; &quot;incidentId&quot;: 6&lt;br&gt;}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontSize=9;" vertex="1" parent="1">
