{
  "info": {
    "name": "Reverde | Gateway APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "forest-biodiversity-service",
      "request": {
        "method": "GET",
        "url": "{{gateway}}/forests/hello"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Gateway returned the correct service\", function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().service).to.eql(\"forest-biodiversity-service\");",
              "});"
            ]
          }
        }
      ]
    },
