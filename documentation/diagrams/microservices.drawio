        <mxCell id="ac-a52" value="{&lt;br&gt;&amp;nbsp; &quot;eventId&quot;: &quot;example-id&quot;,&lt;br&gt;&amp;nbsp; &quot;type&quot;: &quot;VolunteerRegistered&quot;,&lt;br&gt;&amp;nbsp; &quot;occurredAt&quot;: &quot;2026-11-10T09:00:00Z&quot;,&lt;br&gt;&amp;nbsp; &quot;registrationId&quot;: 58,&lt;br&gt;&amp;nbsp; &quot;activityId&quot;: 12,&lt;br&gt;&amp;nbsp; &quot;recoveryProjectId&quot;: 45&lt;br&gt;}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="230" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ac-a53" value="&lt;b&gt;Message (JSON)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="424" width="230" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ac-a54" value="&lt;b&gt;Delivery rules&lt;/b&gt;&lt;br&gt;• Publish after the source data is saved.&lt;br&gt;• The topic exchange routes the message to matching queues.&lt;br&gt;• Acknowledge successful processing and deduplicate by &lt;b&gt;eventId&lt;/b&gt;.&lt;br&gt;• Rejected messages from the primary queue go to the dead-letter exchange and queue." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="640" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ac-a55" value="&lt;b&gt;Proposed event contract&lt;/b&gt;&lt;br&gt;• volunteer-service owns the event.&lt;br&gt;• The recovery service owns its consumer and its local records.&lt;br&gt;• Applies to activities linked to a recovery project.&lt;br&gt;• Exchange, queue and payload details are proposed for integration." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="740" width="700" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram><diagram name="Equipment &amp; resources — synchronous" id="resources-synchronous">
