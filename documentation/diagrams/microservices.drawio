        <mxCell id="sc-a13" value="&lt;b&gt;1&lt;/b&gt; · POST /api/registrations&lt;br&gt;{volunteerId, activityId} + Bearer JWT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
