        </mxCell>
        <mxCell id="sc-a31" value="&lt;b&gt;Request and event&lt;/b&gt;&lt;br&gt;• The API responds after the data has been saved.&lt;br&gt;• Eureka resolves the service. The gateway sends the request to that instance.&lt;br&gt;• Consumers process &lt;b&gt;RecoveryProjectCreated&lt;/b&gt; asynchronously." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="670" y="830" width="610" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
