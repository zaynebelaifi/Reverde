  <diagram name="sync-communication" id="4-communication-synchrone"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1030" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sc-a1" value="&lt;b style='font-size:16px'&gt;Reporting a fire — synchronous path (Gateway → Eureka → incident → forest / fire risk)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;Proposed ReVerde workflow: a user reports a fire in a known forest zone from the React web app.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="1400" height="46" as="geometry" /></mxCell><mxCell id="sc-a2" value="&lt;b&gt;Client app&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;ReVerde · React&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="150" height="800" as="geometry" /></mxCell><mxCell id="sc-a3" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Spring Cloud Gateway&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#1BA1E2;strokeColor=#006EAF;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="64" width="150" height="800" as="geometry" /></mxCell><mxCell id="sc-a4" value="&lt;b&gt;Eureka Server&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Service discovery&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#FAD7AC;strokeColor=#B46504;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="64" width="150" height="800" as="geometry" /></mxCell><mxCell id="sc-a5" value="&lt;b&gt;incident-service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MS3 · Spring Boot&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="64" width="150" height="800" as="geometry" /></mxCell><mxCell id="sc-a6" value="&lt;b&gt;forest-biodiversity&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MS1 · Spring Boot&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="64" width="150" height="800" as="geometry" /></mxCell><mxCell id="sc-a7" value="&lt;b&gt;fire-risk-service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MS2 · Spring Boot&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="64" width="150" height="800" as="geometry" /></mxCell><mxCell id="sc-a8" value="&lt;b&gt;incident_db&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;PostgreSQL&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="64" width="150" height="800" as="geometry" /></mxCell><mxCell id="sc-a9" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;exchange reverde.events&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#FFF3E0;strokeColor=#FF6600;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="64" width="150" height="800" as="geometry" /></mxCell><mxCell id="sc-a10" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="170" width="10" height="670" as="geometry" /></mxCell><mxCell id="sc-a11" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="630" y="340" width="10" height="465" as="geometry" /></mxCell><mxCell id="sc-a12" value="&lt;b&gt;0&lt;/b&gt; · At start-up the services register with Eureka. Discovery clients keep a cached copy of the registry." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=11;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="215" y="120" width="1250" height="30" as="geometry" /></mxCell><mxCell id="sc-a13" value="&lt;b&gt;1&lt;/b&gt; · POST /api/incidents&lt;br&gt;{forestZoneId: 4, fireDate, location} + Bearer JWT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="180" as="sourcePoint" /><mxPoint x="270" y="180" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a14" value="&lt;b&gt;2&lt;/b&gt; · validate the JWT and permissions&lt;br&gt;route /api/incidents/** → lb://INCIDENT-SERVICE" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;fontSize=10;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="200" as="sourcePoint" /><mxPoint x="280" y="226" as="targetPoint" /><Array as="points"><mxPoint x="315" y="200" /><mxPoint x="315" y="226" /></Array></mxGeometry></mxCell><mxCell id="sc-a15" value="&lt;b&gt;3&lt;/b&gt; · where is INCIDENT-SERVICE?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="270" as="sourcePoint" /><mxPoint x="450" y="270" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a16" value="instances (cached registry)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="295" as="sourcePoint" /><mxPoint x="280" y="295" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a17" value="&lt;b&gt;4&lt;/b&gt; · forward to one instance (load balancing)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="340" as="sourcePoint" /><mxPoint x="630" y="340" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a18" value="&lt;b&gt;5&lt;/b&gt; · where are the forest and fire risk services?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="385" as="sourcePoint" /><mxPoint x="460" y="385" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a19" value="addresses (cached registry)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="410" as="sourcePoint" /><mxPoint x="630" y="410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a20" value="&lt;b&gt;6&lt;/b&gt; · GET /api/forest-zones/4&lt;br&gt;&lt;i&gt;(synchronous REST lookup)&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="460" as="sourcePoint" /><mxPoint x="810" y="460" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a21" value="200 Forest zone (404 if unknown)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="485" as="sourcePoint" /><mxPoint x="640" y="485" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a22" value="&lt;b&gt;7&lt;/b&gt; · GET current risk for forest zone 4 &lt;i&gt;(optional)&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="535" as="sourcePoint" /><mxPoint x="990" y="535" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a23" value="Risk context if available" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="560" as="sourcePoint" /><mxPoint x="640" y="560" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a24" value="&lt;b&gt;8&lt;/b&gt; · validate the fire date and location&lt;br&gt;set status to REPORTED" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;fontSize=10;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="585" as="sourcePoint" /><mxPoint x="640" y="611" as="targetPoint" /><Array as="points"><mxPoint x="675" y="585" /><mxPoint x="675" y="611" /></Array></mxGeometry></mxCell><mxCell id="sc-a25" value="&lt;b&gt;9&lt;/b&gt; · INSERT fire incident (REPORTED)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="655" as="sourcePoint" /><mxPoint x="1170" y="655" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a26" value="id = 6" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="680" as="sourcePoint" /><mxPoint x="640" y="680" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a27" value="&lt;b&gt;10&lt;/b&gt; · publish IncidentReported &lt;i&gt;(proposed)&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;fontColor=#2D7600;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="730" as="sourcePoint" /><mxPoint x="1350" y="730" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a28" value="&lt;b&gt;11&lt;/b&gt; · 201 Created · Location: /api/incidents/6" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="790" as="sourcePoint" /><mxPoint x="280" y="790" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a29" value="201 Created + incident details" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="830" as="sourcePoint" /><mxPoint x="100" y="830" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sc-a30" value="&lt;b&gt;Error cases&lt;/b&gt;&lt;br&gt;• 401 / 403 at the gateway for an invalid token or insufficient permissions.&lt;br&gt;• 404 if the selected forest zone is unknown.&lt;br&gt;• 400 if required incident fields are invalid.&lt;br&gt;• 503 if the required forest lookup is unavailable." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="890" width="700" height="120" as="geometry" /></mxCell><mxCell id="sc-a31" value="&lt;b&gt;What to remember&lt;/b&gt;&lt;br&gt;• Eureka resolves service instances. API requests go to the selected instance.&lt;br&gt;• The incident service stores &lt;b&gt;forestZoneId&lt;/b&gt; and owns the incident record.&lt;br&gt;• The forest lookup is required. The risk lookup provides optional context.&lt;br&gt;• The proposed &lt;b&gt;IncidentReported&lt;/b&gt; event leaves downstream processing to consumers." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="890" width="700" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="async-communication" id="5-communication-asynchrone"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="940" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ac-a1" value="&lt;b style='font-size:16px'&gt;Asynchronous communication — RabbitMQ (ReVerde incident verification)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;Proposed topology: the incident service publishes IncidentVerified for recovery planning and biodiversity follow-up.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1380" height="46" as="geometry" /></mxCell><mxCell id="ac-a2" value="&lt;b&gt;RabbitMQ broker&lt;/b&gt; — Docker Compose · AMQP :5672 · management UI :15672 (example ports)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF6600;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=50;spacingTop=12;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="790" height="640" as="geometry" /></mxCell><mxCell id="ac-a3" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ac-a2"><mxGeometry x="12" y="8" width="30" height="30" as="geometry" /></mxCell><mxCell id="ac-prod" value="&lt;b&gt;MS3 · incident-service&lt;/b&gt;&lt;br&gt;producer (Spring AMQP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;spacingLeft=40;fontSize=11;arcSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="293" width="210" height="70" as="geometry" /></mxCell><mxCell id="ac-a4" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ac-prod"><mxGeometry x="8" y="22.0" width="26" height="26" as="geometry" /></mxCell><mxCell id="ac-a5" value="&lt;b&gt;Exchange&lt;/b&gt;&lt;br&gt;&lt;b&gt;reverde.events&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;topic · durable&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.14;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="273" width="170" height="110" as="geometry" /></mxCell><mxCell id="ac-a6" value="&lt;b&gt;biodiversity.incident-verified&lt;/b&gt; &lt;i&gt;(optional)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;verticalLabelPosition=top;verticalAlign=bottom;fontSize=11;labelPosition=center;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="300" height="56" as="geometry" /></mxCell><mxCell id="ac-a7" value="" style="shape=message;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="ac-a6"><mxGeometry x="12" y="16" width="36" height="24" as="geometry" /></mxCell><mxCell id="ac-a8" value="" style="shape=message;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="ac-a6"><mxGeometry x="58" y="16" width="36" height="24" as="geometry" /></mxCell><mxCell id="ac-a9" value="" style="shape=message;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="ac-a6"><mxGeometry x="104" y="16" width="36" height="24" as="geometry" /></mxCell><mxCell id="ac-a10" value="" style="shape=message;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="ac-a6"><mxGeometry x="150" y="16" width="36" height="24" as="geometry" /></mxCell><mxCell id="ac-a11" value="" style="shape=message;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="ac-a6"><mxGeometry x="196" y="16" width="36" height="24" as="geometry" /></mxCell><mxCell id="ac-a12" value="queue" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=9;fontColor=#E65100;align=right;" vertex="1" parent="ac-a6"><mxGeometry x="240" y="18" width="56" height="20" as="geometry" /></mxCell><mxCell id="ac-a13" value="&lt;b&gt;recovery.incident-verified&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;verticalLabelPosition=top;verticalAlign=bottom;fontSize=11;labelPosition=center;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="300" height="56" as="geometry"