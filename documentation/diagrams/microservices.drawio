        </mxCell>
        <mxCell id="sc-a30" value="&lt;b&gt;Error cases&lt;/b&gt;&lt;br&gt;• 401 / 403 if authentication or permissions fail.&lt;br&gt;• 400 if a required field is invalid.&lt;br&gt;• 404 if the equipment or recovery project does not exist.&lt;br&gt;• 409 if available stock is below the requested quantity.&lt;br&gt;• 503 if a required dependency is unavailable." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="830" width="610" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sc-a31" value="&lt;b&gt;Request and event&lt;/b&gt;&lt;br&gt;• The API responds after the data has been saved.&lt;br&gt;• Eureka resolves the service. The gateway sends the request to that instance.&lt;br&gt;• Consumers process &lt;b&gt;ResourceAllocated&lt;/b&gt; asynchronously." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="670" y="830" width="610" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
